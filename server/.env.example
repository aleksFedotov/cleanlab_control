# Секреты — те же, что в GAS Script Properties (см. docs/deploy.md §2)
BOT_TOKEN=
# Первая прачка: имя (сид при пустой таблице Laundries)
LAUNDRY_NAME=Прачечная PRO
# Владелец: логин и пароль, upsert в Users при каждом старте (можно менять пароль через ENV)
OWNER_LOGIN=
OWNER_PASSWORD=
# Вторая прачка (необязательно): создаётся сидом, только если задано имя
# LAUNDRY2_NAME=
WEBHOOK_SECRET=
TV_KEY=
# TV_KEY_2=
# PORT=3100
# DB_PATH=
# APP_TZ=Europe/Moscow
